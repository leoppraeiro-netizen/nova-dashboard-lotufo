{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:DASH_DEV='1'; $env:DASH_SEM_JOBS='1'; $env:DASH_GRAPH_SIMULADOR='dados/correio-simulado'; Set-Location backend; .venv\\Scripts\\python -m uvicorn --factory app.main:create_app --port 8080"],
      "port": 8080
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "Set-Location frontend; npm run dev"],
      "port": 5173
    },
    {
      "name": "prototipo-login",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8777", "--directory", "prototipos/login-3d"],
      "port": 8777
    }
  ]
}
