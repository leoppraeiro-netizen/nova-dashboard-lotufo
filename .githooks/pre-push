#!/bin/sh
# Pre-push versionado (ligado por `git config core.hooksPath .githooks`). O git passa no stdin as refs do push
# (`<ref local> <sha local> <ref remoto> <sha remoto>`); scripts/vazamento.py --push varre, commit a commit, os
# arquivos de cada commit que vai ser enviado. Cherry-pick, rebase, merge e edicao pela web nao passam pelo
# pre-commit, e dado que entrou num commit e saiu no seguinte continua no historico que vira publico.
# Pular uma vez: `git push --no-verify` (nao fazer isso de habito).
raiz=$(git rev-parse --show-toplevel)
cd "$raiz" || exit 1
py_exe="backend/.venv/Scripts/python.exe"               # Windows
[ -x "$py_exe" ] || py_exe="backend/.venv/bin/python"   # Mac/Linux
[ -x "$py_exe" ] || py_exe="python"
command -v "$py_exe" >/dev/null 2>&1 || py_exe="python3"
# Nome da maquina para a checagem de vazamento: DASH_SERVIDOR, ou o nome desta maquina (no Windows). No Mac
# nao ha COMPUTERNAME: sem DASH_SERVIDOR no ~/.zshrc, essa parte da checagem e' pulada com aviso.
DASH_SERVIDOR="${DASH_SERVIDOR:-$COMPUTERNAME}"
export DASH_SERVIDOR

"$py_exe" scripts/vazamento.py --push
rc=$?
if [ "$rc" -eq 1 ]; then
    echo "pre-push: dado real num commit do push (veja acima; o repositorio e' publico). Corrija antes de publicar." >&2
    exit 1
elif [ "$rc" -ne 0 ]; then
    echo "pre-push: scripts/vazamento.py nao rodou (codigo $rc; falta python no PATH ou lista de excecoes mal formada)" >&2
    exit 1
fi
exit 0
